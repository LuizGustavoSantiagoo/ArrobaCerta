<script>
    function formatPurchaseValueInput(input, finalize) {
        if (!input) return;

        let value = input.value || '';
        value = value.replace(/[^\d,]/g, '');

        if (value === '') {
            input.value = '';
            return;
        }

        const parts = value.split(',');
        let intPart = parts.shift() || '0';
        let decPart = parts.join('');

        intPart = intPart.replace(/^0+(?=\d)/, '') || '0';
        if (decPart.length > 2) decPart = decPart.slice(0, 2);

        const intWithThousands = intPart.replace(/\B(?=(\d{3})+(?!\d))/g, '.');

        if (finalize) {
            decPart = (decPart + '00').slice(0, 2);
            input.value = intWithThousands + ',' + decPart;
            return;
        }

        input.value = decPart ? intWithThousands + ',' + decPart : intWithThousands;
    }

    function openCreateCow() {
        const createCow = document.getElementById('createCow');
        const closeCreateCow = document.getElementById('closeCreateCow');
        const isHidden = createCow.classList.contains('hidden');

        if (isHidden) {
            createCow.classList.remove('hidden');
            closeCreateCow.textContent = 'Fechar';
            return;
        }

        createCow.classList.add('hidden');
        closeCreateCow.textContent = 'Adicionar vacas';
    }

    function closeCreateCow() {
        const createCow = document.getElementById('createCow');
        const closeCreateCow = document.getElementById('closeCreateCow');

        if (!createCow.classList.contains('hidden')) {
            createCow.classList.add('hidden');
            closeCreateCow.textContent = 'Adicionar vacas';
        }
    }

    document.addEventListener('keydown', function(event) {
        if (event.key === 'Escape') closeCreateCow();
    });
</script>